# Copy to .env (git-ignored). Values come from the M1 Bicep deployment outputs.
# Authentication uses Entra ID (az login / VS Code / azd login); no API keys needed.

SHOPSENSE_AUTH_MODE=entra
SHOPSENSE_FOUNDRY_RESOURCE=ais-shopsense-dev-xxxxxx
SHOPSENSE_CLAUDE_DEPLOYMENT=claude-opus-5-5
SHOPSENSE_AZURE_OPENAI_ENDPOINT=https://ais-shopsense-dev-xxxxxx.openai.azure.com/
SHOPSENSE_AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Optional tuning
# SHOPSENSE_TRIAGE_EFFORT=low
# SHOPSENSE_LOG_JSON=false
