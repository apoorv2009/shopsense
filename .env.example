# Copy to .env (git-ignored). Values come from the M1 Bicep deployment outputs.
# Authentication uses Entra ID (az login); no API keys needed.

SHOPSENSE_AUTH_MODE=entra
SHOPSENSE_FOUNDRY_RESOURCE=ais-shopsense-dev-xxxxxx
SHOPSENSE_PRIMARY_DEPLOYMENT=gpt-4.1-mini
SHOPSENSE_SECOND_VENDOR_DEPLOYMENT=mistral-medium-2505

# If the second vendor rejects schema-constrained output, switch to JSON mode:
# SHOPSENSE_SECOND_VENDOR_OUTPUT_MODE=json_object

# Claude on Foundry (only with Claude quota; free trials have none)
# SHOPSENSE_CLAUDE_ENABLED=true
# SHOPSENSE_CLAUDE_DEPLOYMENT=claude-opus-5-5

# SHOPSENSE_LOG_JSON=false
